{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "prompt": "This repo is built to be driven by coding agents — read AGENTS.md first. If .env is missing, copy .env.example, set BETTER_AUTH_SECRET, then run `pnpm -F db db`, `pnpm db:push`, `pnpm db:seed`. The `turso` CLI must be on PATH (brew install tursodatabase/tap/turso).",
  "permissions": {
    "allow": [
      "Bash(pnpm verify:*)",
      "Bash(pnpm db:push:*)",
      "Bash(pnpm db:seed:*)",
      "Bash(pnpm dev:web:*)",
      "Bash(pnpm emulate:*)",
      "Bash(pnpm -F db db:*)",
      "Bash(pnpm -F db studio:*)",
      "Bash(agent-browser:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && cd \"$CLAUDE_PROJECT_DIR\" && pnpm install || true",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && pnpm exec ultracite fix --hook"
          }
        ]
      }
    ]
  }
}
