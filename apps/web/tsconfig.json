{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    "checkJs": false,
    "lib": ["ES2023", "ES2024.Promise", "dom", "dom.iterable"],
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/.source": ["./.source/index.ts"],
      "@/*": ["./src/*"],
      "@loremllm/ai-sdk": ["../../packages/ai-sdk/src/index.ts"],
      "@loremllm/ai-sdk/copy-messages-to-clipboard": [
        "../../packages/ai-sdk/src/copy-messages-to-clipboard.ts"
      ],
      "@loremllm/ai-sdk/internal": ["../../packages/ai-sdk/src/shared.ts"],
      "@loremllm/eve": ["../../packages/eve/src/index.ts"]
    },
    "plugins": [{ "name": "next" }],
    "module": "esnext"
  },
  "include": [".", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
