{
  "name": "@loremllm/transport",
  "version": "0.7.1",
  "description": "Deprecated: use @loremllm/ai-sdk (StaticChatTransport) and @loremllm/eve (createStaticEveHandler). This package re-exports both.",
  "keywords": [
    "agent",
    "ai",
    "ai-sdk",
    "chat",
    "chatbot",
    "demo",
    "eve",
    "llm",
    "mock",
    "static-chat",
    "streaming",
    "testing",
    "transport",
    "ui-message",
    "vercel-ai-sdk"
  ],
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./copy-messages-to-clipboard": {
      "types": "./dist/copy-messages-to-clipboard.d.ts",
      "import": "./dist/copy-messages-to-clipboard.js"
    },
    "./eve": {
      "types": "./dist/eve.d.ts",
      "import": "./dist/eve.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loremllm/ai-sdk": "workspace:^",
    "@loremllm/eve": "workspace:^"
  },
  "devDependencies": {
    "ai": "^7.0.181",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0"
  }
}
