{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "TURSO_DATABASE_URL=http://127.0.0.1:8080 node --import tsx --test 'src/**/*.test.ts'",
    "seed": "pnpm with-env tsx scripts/seed.ts",
    "seed:remote": "dotenv -e ../../.env.production.local -- tsx scripts/seed.ts",
    "with-env": "dotenv -e ../../.env --",
    "backfill:vectors": "pnpm with-env tsx scripts/backfill-vectors.ts"
  },
  "dependencies": {
    "@orpc/server": "catalog:",
    "@repo/db": "workspace:^",
    "ai": "^7.0.84",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.23.12",
    "typescript": "catalog:"
  }
}
