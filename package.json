{
  "name": "loremllm",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "pnpm -F db push",
    "db:push-remote": "pnpm -F db push:remote",
    "db:seed": "pnpm -F @repo/service seed",
    "db:start": "pnpm -F db db",
    "dev": "turbo watch db studio dev --continue",
    "dev:web": "turbo watch dev --filter=@repo/web --continue",
    "emulate": "npx emulate@0.9.0 --service github",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "smoke": "dotenv -e .env -- tsx scripts/smoke.ts",
    "test": "turbo run test --continue",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.1.0",
    "@orpc/client": "catalog:",
    "@repo/contract": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "^8.3.0",
    "zod": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
